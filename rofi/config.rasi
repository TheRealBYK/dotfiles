@import "/home/byk/.cache/wal/colors-rofi-dark.rasi"
/* Replace the path with your USERNAME */

* {
    font:   "JetBrainsMono 10";
    margin:     0px;
    padding:    0px;
    spacing:    0px;
}

configuration {
    modi: "drun,run,window,emoji,calc";
    show-icons: true;
    icon-theme: "Papirus";
    kb-row-up: "Up,Control+k,Shift+Tab,Shift+ISO_Left_Tab";
    kb-row-down: "Down,Control+j";
    kb-accept-entry: "Return,KP_Enter";
    kb-remove-to-eol: "Control+Shift+e";
    kb-mode-previous: "Control+h";
    kb-mode-complete: "Control+i";
    kb-mode-next: "Control+l";
    kb-remove-char-back: "BackSpace";
}

window {
    location:       north;
    y-offset:       calc(50% - 335px);
    width:          768px;
    border-radius:  12px;
    border: @color8;
    border: 4px;
}

mainbox {
    padding:    12px;
}

inputbar {
    border:         2px;
    border-radius:  8px;

    padding:    8px 16px;
    spacing:    8px;
    children:   [ "prompt", "textbox-prompt-colon", "entry" ];
}

prompt {
    enabled:                     true;
}

entry {
    placeholder:        "Search";
}

message {
    margin:             12px 0 0;
    border-radius:  8px;
}

textbox {
    padding:    8px 24px;
}

listview {
    margin:     32px 0 0;
    lines:      5;
    columns:    5;

    fixed-height: true;
}

element {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     15px 10px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @background;
    background-color:            transparent;
    text-color:                  @foreground;
    orientation:                 vertical;
    cursor:                      pointer;
}

element normal active {
}

element alternate active {
}

element selected normal, element selected active {
    background-color:            @foreground;
    text-color:                  @background;
    border-radius: 16px;
}

element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    size:                        64px;
    cursor:                      inherit;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    highlight:                   inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.5;
}
